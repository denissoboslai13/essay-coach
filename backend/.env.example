# Copy to .env and fill in. Never commit .env.
#
# Running it on your own machine: only ANTHROPIC_API_KEY is needed, keep LOCAL_MODE=true.
# Hosting it for others (Docker): see deploy/README.md. Docker always sets LOCAL_MODE=false.

ANTHROPIC_API_KEY=

# No login: one local account, no daily limits. Uses your own key above
LOCAL_MODE=true

# Model for regular users, and for admins (empty = same as users).
# Haiku is ~20x cheaper than Sonnet but untested for this task: run tests/test_live.py with it first.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ADMIN_MODEL=
# Thinking effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

DATABASE_URL=sqlite:///./essay_coach.db
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# --- Hosted version only (ignored in LOCAL_MODE) ---
# OAuth client id from Google Cloud Console (see deploy/README.md). Public, not a secret.
GOOGLE_CLIENT_ID=
# Comma-separated. No invite needed, no daily limits
ADMIN_EMAILS=
# true when served over HTTPS (the Docker setup forces it)
COOKIE_SECURE=false
SESSION_DAYS=30

# Cost limits (days and months in UTC)
DAILY_REVIEWS_PER_USER=10
DAILY_DISPUTES_PER_USER=10
MONTHLY_BUDGET_USD=10
