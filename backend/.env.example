# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Model used for feedback. Change here to swap models without touching code.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Thinking effort: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium

DATABASE_URL=sqlite:///./essay_coach.db
# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
